# GHL inbound webhook URL that /api/lead proxies form submissions to.
GHL_LEAD_WEBHOOK_URL=

# Public demo number in E.164 format (e.g. +46701234567).
# If unset, the live-demo section renders the animated visualizer only —
# the site must never show a dead number.
NEXT_PUBLIC_DEMO_PHONE_NUMBER=

# Real sales/contact number shown in the header, hero and contact page.
NEXT_PUBLIC_CONTACT_PHONE_NUMBER=

# Canonical site origin, used for metadata, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GA4 measurement ID (wired in Phase 4).
NEXT_PUBLIC_GA4_ID=
