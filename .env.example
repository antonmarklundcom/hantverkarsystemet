# GoHighLevel inbound webhook that receives leads submitted via /api/lead.
# Server-side only — never exposed to the client bundle.
GHL_LEAD_WEBHOOK_URL=

# Public demo number for "ring och se det hända", E.164 format (+46...).
# If unset, the live-demo section falls back to the animated visualizer only.
NEXT_PUBLIC_DEMO_PHONE_NUMBER=

# Real sales/contact number shown across the site as a tel: link.
NEXT_PUBLIC_CONTACT_PHONE_NUMBER=

# Canonical site origin, no trailing slash. Used by metadata, sitemap, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://hantverkarsystemet.se

# GA4 measurement ID, wired in Phase 4. Leave empty until launch.
NEXT_PUBLIC_GA4_ID=
